{
  "name": "glitch-brushes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:effect-previews": "node node_modules/esbuild/bin/esbuild scripts/generate-effect-previews.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/generate-effect-previews.mjs && node node_modules/.tmp/generate-effect-previews.mjs",
    "audit:image-brush-styles": "node node_modules/esbuild/bin/esbuild scripts/image-brush-style-audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/image-brush-style-audit.mjs && node node_modules/.tmp/image-brush-style-audit.mjs",
    "audit:controls": "vitest run src/controlSensitivity.test.ts",
    "acceptance:ui": "node scripts/interface-redesign-acceptance.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
